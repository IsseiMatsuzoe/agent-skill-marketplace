{
  "version": 2,
  "agents": [
    {
      "alias": "claude",
      "backend": "anthropic",
      "model": "claude-sonnet-5-5",
      "capabilities": [
        "general",
        "design",
        "review",
        "rewrite",
        "image"
      ],
      "privacy_profile": "direct",
      "default_depth": "standard",
      "default_max_output_tokens": 2048,
      "max_output_tokens": 4096,
      "enabled": true,
      "premium": false
    },
    {
      "alias": "grok",
      "backend": "xai",
      "model": "grok-4.7",
      "capabilities": [
        "general",
        "design",
        "review",
        "rewrite",
        "x_research"
      ],
      "privacy_profile": "direct",
      "default_depth": "standard",
      "default_max_output_tokens": 2048,
      "max_output_tokens": 4096,
      "max_search_turns": 2,
      "enabled": true,
      "premium": false,
      "output_limit_policy": "advisory",
      "reasoning_defaults": {
        "ordinary": "medium",
        "retrieval": "low"
      }
    },
    {
      "alias": "gemini",
