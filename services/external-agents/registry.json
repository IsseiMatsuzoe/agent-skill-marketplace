  "routing": {
    "direct": {
      "anthropic": "auto_allowed",
      "xai": "auto_allowed"
    },
    "openrouter": {
      "approved_model_providers": [
        "google",
        "meta"
      ],
      "approved_providers": [
        "google-vertex",
        "google-ai-studio",
        "meta"
      ],
      "explicit_providers": {
        "moonshotai": [
          "novita"
        ],
        "qwen": [
          "alibaba"
        ],
        "deepseek": [
          "deepseek"
        ]
      }
    }
