      "model": "moonshotai/kimi-k2.5",
      "capabilities": [
        "general",
        "design",
        "review",
        "rewrite"
      ],
      "privacy_profile": "deny_collection",
      "default_depth": "standard",
      "default_max_output_tokens": 2048,
      "max_output_tokens": 4096,
      "enabled": true,
      "premium": false
    },
    {
