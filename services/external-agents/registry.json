      "default_depth": "standard",
      "default_max_output_tokens": 2048,
      "max_output_tokens": 4096,
      "enabled": true,
      "premium": false
    },
    {
      "alias": "muse",
      "backend": "openrouter",
      "model": "meta/muse-spark-1.3",
      "capabilities": [
        "general",
